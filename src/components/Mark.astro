---
// The playground mark, floating top-left on every page. Links home.
interface Props { label?: boolean }
const { label = false } = Astro.props;
---
<a href="/" aria-label="Playground home"
  class="fixed top-3 left-3 z-50 flex h-9 items-center gap-2 rounded-xl bg-background/80 pr-3 pl-1 shadow-sm ring-1 ring-border backdrop-blur-md transition-colors hover:ring-foreground/30 md:top-4 md:left-4"
  class:list={[!label && "pr-1"]}>
  <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="var(--ink)" />
    <!-- Spell braces: code that summons. Picked by Al 26 November 2026. -->
    <g style="--fg: var(--paper)"><path d="M11 6.5c-2.7 0-2.9 1.9-2.9 4.4 0 2.4-.8 4.2-3.1 5.1 2.3.9 3.1 2.7 3.1 5.1 0 2.5.2 4.4 2.9 4.4" fill="none" stroke="var(--fg)" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8"/><path d="M21 6.5c2.7 0 2.9 1.9 2.9 4.4 0 2.4.8 4.2 3.1 5.1-2.3.9-3.1 2.7-3.1 5.1 0 2.5-.2 4.4-2.9 4.4" fill="none" stroke="var(--fg)" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8"/><path d="M16 10 Q16 16 22 16 Q16 16 16 22 Q16 16 10 16 Q16 16 16 10Z" fill="var(--fg)"/></g>
  </svg>
  {label && <span class="text-sm font-medium">Playground</span>}
</a>
