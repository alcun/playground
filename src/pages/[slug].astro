---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import DemoPanel from "../components/DemoPanel.tsx";
import { demos } from "../lib/registry";

export function getStaticPaths() {
  return demos.map((d) => ({ params: { slug: d.slug }, props: { title: d.title, description: d.description } }));
}
const { slug } = Astro.params;
const { title, description } = Astro.props;
---
<Base title={`${title} · Playground`} description={description}>
  <Mark />
  <div class="fixed inset-0 grid grid-rows-[1fr_auto] md:grid-cols-[1fr_300px] md:grid-rows-1">
    <div id="stage" class="stage relative overflow-hidden"></div>
    <aside class="max-h-[45svh] overflow-y-auto border-t p-4 md:max-h-none md:border-t-0 md:border-l">
      <h1 class="mb-4 text-sm font-medium">{title}</h1>
      <DemoPanel client:load slug={slug} stageId="stage" />
    </aside>
  </div>
</Base>
