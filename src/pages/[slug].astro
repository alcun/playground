---
import Base from "../layouts/Base.astro";
import ThemeButton from "../components/ThemeButton.astro";
import { demos } from "../lib/registry";

export function getStaticPaths() {
  return demos.map((d) => ({ params: { slug: d.slug }, props: { title: d.title, description: d.description } }));
}
const { slug } = Astro.params;
const { title, description } = Astro.props;
---
<Base title={`${title} · Playground`} description={description}>
  <div class="demo" data-slug={slug}>
    <div class="stage"></div>
    <nav class="crumb">
      <a href="/">~/playground</a><span aria-hidden="true">/</span><h1>{slug}</h1>
    </nav>
    <section class="console" aria-label="Controls">
      <div class="console-bar">
        <span class="title">{slug}</span>
        <ThemeButton />
        <button type="button" class="console-toggle" aria-expanded="true" aria-controls="panel">_</button>
      </div>
      <div class="panel" id="panel"></div>
    </section>
  </div>
</Base>
<script>
  import { createPanel } from "../lib/panel";
  import type { Demo } from "../lib/types";

  // Lazy, so each page downloads only its own demo.
  const loaders = import.meta.glob<{ demo: Demo }>("../demos/*/demo.ts");
  const root = document.querySelector<HTMLElement>(".demo")!;
  const slug = root.dataset.slug!;
  const stage = root.querySelector<HTMLElement>(".stage")!;
  const panel = root.querySelector<HTMLElement>(".panel")!;
  const consoleEl = root.querySelector<HTMLElement>(".console")!;
  const toggle = root.querySelector<HTMLButtonElement>(".console-toggle")!;

  // Collapsed to its title bar on a phone to start with, so the toy is seen first.
  const show = (open: boolean) => {
    consoleEl.classList.toggle("closed", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "_" : "+";
    toggle.setAttribute("aria-label", open ? "Hide controls" : "Show controls");
  };
  show(!matchMedia("(max-width: 640px)").matches);
  toggle.addEventListener("click", () => show(consoleEl.classList.contains("closed")));

  loaders[`../demos/${slug}/demo.ts`]().then(({ demo }) => {
    let instance: ReturnType<Demo["mount"]> | undefined;
    const params = createPanel(panel, slug, demo.controls, {
      change: (p) => instance?.update(p),
      reset: () => instance?.reset?.(),
    });
    instance = demo.mount(stage, params);
  });
</script>
