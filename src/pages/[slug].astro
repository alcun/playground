---
import Base from "../layouts/Base.astro";
import { demos } from "../lib/registry";

export function getStaticPaths() {
  return demos.map((d) => ({ params: { slug: d.slug }, props: { title: d.title, description: d.description } }));
}
const { slug } = Astro.params;
const { title, description } = Astro.props;
---
<Base title={`${title} · Playground`} description={description}>
  <div class="demo" data-slug={slug}>
    <div class="stage"></div>
    <aside class="side">
      <p><a href="/">Playground</a> / {title}</p>
      <div class="panel"></div>
    </aside>
  </div>
</Base>
<script>
  import { createPanel } from "../lib/panel";
  import type { Demo } from "../lib/types";

  // Lazy, so each page downloads only its own demo.
  const loaders = import.meta.glob<{ demo: Demo }>("../demos/*/demo.ts");
  const root = document.querySelector<HTMLElement>(".demo")!;
  const slug = root.dataset.slug!;
  const stage = root.querySelector<HTMLElement>(".stage")!;
  const panel = root.querySelector<HTMLElement>(".panel")!;
  loaders[`../demos/${slug}/demo.ts`]().then(({ demo }) => {
    let instance: ReturnType<Demo["mount"]> | undefined;
    const params = createPanel(panel, slug, demo.controls, {
      change: (p) => instance?.update(p),
      reset: () => instance?.reset?.(),
    });
    instance = demo.mount(stage, params);
  });
</script>
