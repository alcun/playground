---
import Base from "../layouts/Base.astro";
import ThemeButton from "../components/ThemeButton.astro";
import { demos } from "../lib/registry";
---
<Base title="Playground" description="Small interactive demos with the knobs left on.">
  <header class="bar">
    <h1>Playground</h1>
    <span class="spacer"></span>
    <ThemeButton />
  </header>
  <main class="grid">
    {demos.map((d) => (
      <a class="card" href={`/${d.slug}/`}>
        <strong>{d.title}</strong>
        <span>{d.description}</span>
      </a>
    ))}
  </main>
</Base>
<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    padding: 16px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .card {
    display: grid;
    gap: 6px;
    padding: 18px;
    min-height: 120px;
    align-content: start;
    text-decoration: none;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    border-radius: 12px;
  }
  .card:hover { border-color: var(--ink-faint); }
  .card strong { font-weight: 500; }
  .card span { color: var(--ink-soft); font-size: 14px; }
</style>
