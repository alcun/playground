---
import Base from "../layouts/Base.astro";
import { demos } from "../lib/registry";
---
<Base title="Playground" description="Small interactive demos with the knobs left on.">
  <main>
    <header class="flex items-baseline justify-between p-4 md:px-6">
      <h1 class="text-sm font-medium">Playground</h1>
      <a href="https://github.com/alcun/playground" class="text-sm text-muted-foreground hover:text-foreground">Source</a>
    </header>
    <ul class="grid grid-cols-1 border-t sm:grid-cols-2 lg:grid-cols-3">
      {demos.map((d) => (
        <li class="border-b sm:border-r">
          <a href={`/${d.slug}/`} class="group relative block aspect-square focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring">
            <div data-live={d.slug} class="stage pointer-events-none absolute inset-0 overflow-hidden"></div>
            <span class="absolute bottom-3 left-3 rounded-md bg-background/85 px-1.5 py-0.5 text-sm font-medium">{d.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <script>import { watch } from "../lib/live"; watch();</script>
</Base>
