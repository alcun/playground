---
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import ThemeButton from "../components/ThemeButton.astro";
import { demos } from "../lib/registry";

const hasThumb = (slug: string) =>
  existsSync(`public/thumbs/${slug}-light.webp`) && existsSync(`public/thumbs/${slug}-dark.webp`);
const width = Math.max(...demos.map((d) => d.slug.length)) + 2;
---
<Base title="Playground" description="Small toys with the knobs left on.">
  <div class="term">
    <header>
      <span><span class="dim">~/playground $</span> ls</span>
      <ThemeButton />
    </header>

    <main class="split">
      <ul class="ls" style={`--w: ${width}ch`}>
        {demos.map((d, i) => (
          <li>
            <a href={`/${d.slug}/`} data-slug={d.slug} data-thumb={hasThumb(d.slug) ? "1" : undefined} aria-current={i === 0 ? "true" : undefined}>
              <span class="slug">{d.slug}</span>
              <span class="what">{d.description}</span>
            </a>
          </li>
        ))}
      </ul>

      <figure class="preview" aria-hidden="true">
        <img class="light" alt="" width="800" height="600" />
        <img class="dark" alt="" width="800" height="600" />
      </figure>
    </main>

    <footer>
      <span class="dim">{demos.length} toys, knobs left on.</span>
      <span><a href="https://github.com/alcun/playground">source</a> <span class="dim">by</span> <a href="https://alcun.dev">alcun.dev</a></span>
    </footer>
  </div>
</Base>

<script>
  // The preview pane follows whichever row is pointed at or focused.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".ls a")];
  const imgs = document.querySelectorAll<HTMLImageElement>(".preview img");
  const show = (a: HTMLAnchorElement) => {
    for (const l of links) l.removeAttribute("aria-current");
    a.setAttribute("aria-current", "true");
    const has = a.dataset.thumb === "1";
    imgs.forEach((img) => {
      img.hidden = !has;
      if (has) img.src = `/thumbs/${a.dataset.slug}-${img.className}.webp`;
    });
  };
  for (const a of links) {
    a.addEventListener("pointerenter", () => show(a));
    a.addEventListener("focus", () => show(a));
  }
  if (links[0]) show(links[0]);
</script>

<style>
  .term {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 16px;
  }
  header, footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: var(--row);
  }
  footer { flex-wrap: wrap; padding-top: 16px; }
  footer a { text-underline-offset: 3px; }
  .dim { color: var(--ink-faint); }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-content: start;
    padding-top: 16px;
  }
  @media (min-width: 900px) {
    .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: start; }
  }

  .ls { list-style: none; margin: 0; padding: 0; }
  .ls a {
    display: grid;
    grid-template-columns: var(--w) 1fr;
    gap: 0 8px;
    padding: 6px 8px;
    margin: 0 -8px;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .ls .slug { color: var(--ink); white-space: pre; }
  .ls .slug::before { content: "  "; }
  .ls a[aria-current="true"] { background: var(--well); }
  .ls a[aria-current="true"] .slug::before { content: "> "; color: var(--accent); }
  .ls .what { text-wrap: pretty; }
  @media (max-width: 560px) {
    .ls a { grid-template-columns: 1fr; padding-block: 10px; }
    .ls .what { padding-left: 2ch; color: var(--ink-faint); }
  }

  .preview {
    margin: 0;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--hair);
    background: var(--paper);
    position: sticky;
    top: 16px;
  }
  .preview img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .preview .dark { display: none; }
  :global(:root[data-theme="dark"]) .preview .light { display: none; }
  :global(:root[data-theme="dark"]) .preview .dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .preview .light { display: none; }
    :global(:root:not([data-theme="light"])) .preview .dark { display: block; }
  }
  .preview img[hidden] { display: none !important; }
  /* On a phone the list is the page; there is no pointer to follow. */
  @media (max-width: 899px) { .preview { display: none; } }
</style>
