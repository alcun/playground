---
import Base from "../layouts/Base.astro";
import { demos } from "../lib/registry";
---
<Base title="Playground" description="Small interactive demos with the knobs left on.">
  <main style="max-width: 640px; margin: 0 auto; padding: 16px;">
    <h1>Playground</h1>
    <ul>
      {demos.map((d) => (
        <li><a href={`/${d.slug}/`}>{d.title}</a>: {d.description}</li>
      ))}
    </ul>
    <p><a href="https://github.com/alcun/playground">Source</a></p>
  </main>
</Base>
